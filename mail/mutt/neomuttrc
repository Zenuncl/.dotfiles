# ─── NeoMutt — minimal config ─────────────────────────────────────────────────
# Requires: mbsync (isync), msmtp, notmuch, lynx, pass
#
# Symlink: ~/.config/mutt → ~/.dotfiles/mail/mutt
#
# Accounts: run gen.sh to generate from accounts/*.conf,
# or manually copy accounts/example.muttrc.

# ─── Paths ────────────────────────────────────────────────────────────────────

set mailcap_path     = $HOME/.config/mutt/mailcap
set tmpdir           = /tmp

# ─── Source config modules ────────────────────────────────────────────────────

source $HOME/.config/mutt/colors.muttrc
source $HOME/.config/mutt/keys/binds.muttrc

# Account config — generated by gen.sh, or source manually
source `FILE=$HOME/.config/mutt/accounts/init.muttrc; test -f $FILE && echo $FILE || echo /dev/null`
# Manual alternative: source $HOME/.config/mutt/accounts/personal.muttrc

# ─── General ──────────────────────────────────────────────────────────────────

unset help                            # hide top help bar — cleaner UI
set sleep_time       = 0              # no pause between mailbox switches
set wait_key         = no             # don't prompt "press key to continue"
set mark_old         = no             # keep unread until explicitly read
set fast_reply                        # skip prompts when replying
set fcc_attach                        # save attachments with sent mail
set include                           # include original in replies
set forward_format   = "Fwd: %s"
set forward_quote                     # quote forwarded message
set reverse_name                      # reply as whoever the mail was sent to
set auto_tag                          # apply actions to tagged messages
set flag_safe                         # protect flagged messages from deletion
set rfc2047_parameters = yes          # decode RFC 2047 MIME params

set mail_check       = 30             # check for new mail every 30s
set timeout          = 60             # idle timeout (triggers timeout-hook)

# ─── Pager / view ────────────────────────────────────────────────────────────

set pager_index_lines = 8             # show mini-index in pager
set pager_context     = 3             # context lines when scrolling
set pager_stop                        # don't advance to next message at end
set menu_scroll                       # scroll line-by-line (not page-by-page)
set smart_wrap                        # wrap at word boundaries
set wrap              = 0             # wrap at terminal width
set allow_ansi                        # render ANSI color codes in messages

# ─── Headers ──────────────────────────────────────────────────────────────────

ignore *
unignore from: to: cc: date: subject:
unhdr_order *
hdr_order from: to: cc: date: subject:

# ─── Format strings (Nerd Font icons) ────────────────────────────────────────

set date_format      = "%a %d %b %H:%M"
set index_format     = "  %zc %zs  %-30.30L  %@attachment_info@  %?M?(%M) ?%-30.100s %> %D  "
set pager_format     = " %n %T %s%*  %{!%d %b · %H:%M} %?X?  %X? %P "
# status_format is set per-account by gen.sh (shows tab bar)
set compose_format   = " Compose  [size: %l  attachments: %a] %>"
set attach_format    = "%u%D  %T%-75.75d  %5s · %m/%M"

set to_chars         = "     "
set status_chars     = "  "
set flag_chars       = "      "
set hidden_tags      = "unread,draft,flagged,passed,replied,attachment,signed,encrypted"

tag-transforms "replied"    "↩ " \
               "encrypted"  " " \
               "signed"     " " \
               "attachment" " "

index-format-hook  attachment_info  "~X >1"  "  %X"
index-format-hook  attachment_info  "~X 1"   " "
index-format-hook  attachment_info  "~A"     "   "

# ─── Threading & sorting ─────────────────────────────────────────────────────

set use_threads      = reverse        # threaded view, newest on top
set sort             = last-date      # sort threads by most recent message
set collapse_all     = yes            # collapse all threads by default
set uncollapse_new   = yes            # auto-expand threads with new messages
set thread_received  = yes            # thread by received date, not sent
set narrow_tree      = yes            # compact thread tree indicators

# ─── Sidebar ──────────────────────────────────────────────────────────────────

set sidebar_visible       = yes
set sidebar_width         = 28
set sidebar_short_path    = yes
set sidebar_folder_indent = yes
set sidebar_indent_string = "  "
set sidebar_divider_char  = "│"
set sidebar_next_new_wrap = yes
# Change to `yes` to hide empty folders (Drafts, Trash when empty)
set sidebar_non_empty_mailbox_only = no
set sidebar_format        = " %D%?F? [%F]?%* %?N?%N/?%S "

# ─── Notmuch integration ─────────────────────────────────────────────────────

set nm_default_url   = "notmuch://$HOME/.local/share/mail"
set nm_query_type    = threads
set nm_record_tags   = "sent"
set virtual_spoolfile = yes

# ─── Content handling ────────────────────────────────────────────────────────

auto_view text/html
auto_view text/plain
auto_view application/ics
auto_view text/calendar
auto_view text/markdown
auto_view text/x-markdown
auto_view text/x-diff
auto_view text/x-patch
alternative_order text/plain text/enriched text/html

# ─── Quote detection ─────────────────────────────────────────────────────────

set quote_regexp = "^( {0,4}[>|:#%]| {0,4}[a-z0-9]+[>|]+)+"

# ─── Editor ───────────────────────────────────────────────────────────────────

set editor = "$HOME/.config/mutt/scripts/mutt-trim %s; nvim +':set textwidth=72' +':set wrapmargin=0' +':set wrap' +':set spell' %s"

# ─── GPG / PGP ────────────────────────────────────────────────────────────────

set crypt_use_gpgme  = yes
set crypt_autopgp    = yes
set crypt_autosmime  = no
set pgp_self_encrypt = yes
set crypt_autosign   = no            # toggle with Alt-s (see binds)
# set pgp_default_key = "YOUR_KEY_ID"

# ─── Auto-sync on idle ───────────────────────────────────────────────────────

timeout-hook 'exec sync-mailbox'

# ─── Sounds ───────────────────────────────────────────────────────────────────

set beep     = no
set beep_new = yes
