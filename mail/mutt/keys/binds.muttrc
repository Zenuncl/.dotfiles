# ─── NeoMutt keybindings — vim-style ─────────────────────────────────────────

# ─── Index navigation ────────────────────────────────────────────────────────

bind index g  noop
bind index gg first-entry
bind index G  last-entry
bind index j  next-entry
bind index k  previous-entry
bind index J  next-thread
bind index K  previous-thread
bind index \Cd half-down
bind index \Cu half-up
bind index l  display-message
bind index h  noop

bind index R  group-reply
bind index \Cn next-unread
bind index \Cp previous-unread

# Collapse / expand
bind index <Space>  collapse-thread
bind index zA       collapse-all

# ─── Pager navigation ────────────────────────────────────────────────────────

bind pager g  noop
bind pager gg top
bind pager G  bottom
bind pager j  next-line
bind pager k  previous-line
bind pager J  next-entry
bind pager K  previous-entry
bind pager \Cd half-down
bind pager \Cu half-up
bind pager h  exit
bind pager l  view-attachments

bind pager R  group-reply
bind pager \Cn next-unread
bind pager \Cp previous-unread

# ─── Sidebar ─────────────────────────────────────────────────────────────────

bind index,pager B   sidebar-toggle-visible
bind index,pager \Cj sidebar-next
bind index,pager \Ck sidebar-prev
bind index,pager \Co sidebar-open

# ─── Mail operations ─────────────────────────────────────────────────────────

bind index       d  delete-message
bind index       u  undelete-message
bind index       U  undelete-thread
bind index,pager s  save-message
bind index       t  tag-entry

# Quick archive: move to Archive folder
macro index,pager A "<save-message>=Archive<enter>" "archive message"

# ─── Compose ──────────────────────────────────────────────────────────────────

bind compose p  postpone-message
bind compose y  send-message

# ─── Sync ─────────────────────────────────────────────────────────────────────

macro index O "<shell-escape>mbsync --config ~/.config/isync/mbsyncrc --all && notmuch new<enter>" "sync all mail"
# Per-account `o` macro is defined in each account file (e.g. accounts/personal.muttrc)

# ─── Folder navigation (g prefix) ────────────────────────────────────────────

macro index gi "<change-folder>=Inbox<enter>"          "go to inbox"
macro index gs "<change-folder>=Sent<enter>"            "go to sent"
macro index gd "<change-folder>=Drafts<enter>"          "go to drafts"
macro index gt "<change-folder>=Trash<enter>"           "go to trash"
macro index ga "<change-folder>=Archive<enter>"         "go to archive"

# ─── Notmuch search ──────────────────────────────────────────────────────────

# Alt-g: global search across all accounts
macro index \eg "<enter-command>unset wait_key<enter><shell-escape>read -p 'notmuch search: ' x; echo \$x >~/.cache/mutt_terms<enter><limit>~i \"\`notmuch search --output=messages \$(cat ~/.cache/mutt_terms) | head -n 600 | perl -le '@a=<>;chomp@a;s/^id:// for@a;\$,=\"|\";print@a'\`\"<enter>" "search all mail (notmuch)"

# Alt-f: per-account search (overridden per account by gen.sh)

# Account switching (F2, F3, …) is auto-generated by gen.sh in accounts/init.muttrc

# ─── Compose ─────────────────────────────────────────────────────────────────

# Convert markdown body to HTML before sending
macro compose M "F pandoc -s -f markdown -t html \ny^T^Utext/html; charset=UTF-8\n" "markdown → HTML"

# ─── Attachments ──────────────────────────────────────────────────────────────

# View patch/diff with delta (colorized side-by-side)
macro attach P "|delta --side-by-side --line-numbers | less -RFX<enter>" "view patch with delta"

# ─── Misc ─────────────────────────────────────────────────────────────────────

macro index,pager \Cl "<pipe-message>urlscan<enter>" "extract URLs"
bind attach       <Return> view-mailcap
