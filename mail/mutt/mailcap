# ─── MIME type handlers ───────────────────────────────────────────────────────

# HTML → lynx (inline rendering)
text/html; lynx -assume_charset=%{charset} -display_charset=utf-8 -collapse_br_tags -dump %s; nametemplate=%s.html; copiousoutput

# Calendar invites → mutt-viewical (human-readable)
application/ics; ~/.config/mutt/scripts/mutt-viewical %s; copiousoutput
text/calendar;   ~/.config/mutt/scripts/mutt-viewical %s; copiousoutput

# Markdown → glow (terminal rendering with Catppuccin theme)
text/markdown;   glow -s ~/.config/glow/catppuccin-macchiato.json -w 80 %s; copiousoutput
text/x-markdown; glow -s ~/.config/glow/catppuccin-macchiato.json -w 80 %s; copiousoutput

# Patches/diffs → delta (colorized)
text/x-diff;  delta %s; copiousoutput
text/x-patch; delta %s; copiousoutput
