# ─── mbsync (isync) config ────────────────────────────────────────────────────
#
# Copy to the real config:
#   cp mbsyncrc.example mbsyncrc
#
# Symlink: ~/.config/isync → ~/.dotfiles/mail/isync
#
# Test:   mbsync --config ~/.config/isync/mbsyncrc --verbose gmail
# Full:   mbsync --config ~/.config/isync/mbsyncrc --all
# Combo:  mbsync --config ~/.config/isync/mbsyncrc --all && notmuch new

# ─── Global defaults ─────────────────────────────────────────────────────────

Create      Both
Expunge     Both
SyncState   *

# ──────────────────────────────────────────────────────────────────────────────
# Account: Gmail
# ──────────────────────────────────────────────────────────────────────────────

IMAPAccount gmail
Host        imap.gmail.com
Port        993
User        you@gmail.com
PassCmd     "pass show email/gmail"
AuthMechs   LOGIN
TLSType     IMAPS
CertificateFile /etc/ssl/certs/ca-certificates.crt

IMAPStore gmail-remote
Account   gmail

MaildirStore gmail-local
Subfolders Verbatim
Path       ~/.local/share/mail/gmail/
Inbox      ~/.local/share/mail/gmail/Inbox

Channel gmail-inbox
Far     :gmail-remote:INBOX
Near    :gmail-local:Inbox

Channel gmail-sent
Far     :gmail-remote:"[Gmail]/Sent Mail"
Near    :gmail-local:Sent
Create  Near

Channel gmail-drafts
Far     :gmail-remote:"[Gmail]/Drafts"
Near    :gmail-local:Drafts
Create  Near

Channel gmail-trash
Far     :gmail-remote:"[Gmail]/Trash"
Near    :gmail-local:Trash
Create  Near

Channel gmail-archive
Far     :gmail-remote:"[Gmail]/All Mail"
Near    :gmail-local:Archive
Create  Near

Group gmail
Channel gmail-inbox
Channel gmail-sent
Channel gmail-drafts
Channel gmail-trash
Channel gmail-archive

# ──────────────────────────────────────────────────────────────────────────────
# Account: Work (generic IMAP — adapt host/user/pass)
# ──────────────────────────────────────────────────────────────────────────────
#
# IMAPAccount work
# Host        imap.example.com
# Port        993
# User        you@example.com
# PassCmd     "pass show email/work"
# TLSType     IMAPS
# CertificateFile /etc/ssl/certs/ca-certificates.crt
#
# IMAPStore work-remote
# Account   work
#
# MaildirStore work-local
# Subfolders Verbatim
# Path       ~/.local/share/mail/work/
# Inbox      ~/.local/share/mail/work/Inbox
#
# Channel work-inbox
# Far     :work-remote:INBOX
# Near    :work-local:Inbox
#
# Channel work-sent
# Far     :work-remote:Sent
# Near    :work-local:Sent
# Create  Near
#
# Group work
# Channel work-inbox
# Channel work-sent
