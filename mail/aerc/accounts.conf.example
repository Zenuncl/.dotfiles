# ─── aerc accounts — example ──────────────────────────────────────────────────
#
# This file is normally generated by gen.sh from accounts/*.conf.
# Copy to accounts.conf for manual setup:
#   cp accounts.conf.example accounts.conf
#   chmod 600 accounts.conf
#
# Docs: man aerc-accounts, aerc-imap, aerc-smtp

[gmail]
source            = imaps://you%40gmail.com@imap.gmail.com:993
source-cred-cmd   = pass show email/gmail
outgoing          = smtp://you%40gmail.com@smtp.gmail.com:587
outgoing-cred-cmd = pass show email/gmail
default           = INBOX
from              = Your Name <you@gmail.com>
copy-to           = [Gmail]/Sent Mail
archive           = [Gmail]/All Mail
postpone          = [Gmail]/Drafts
check-mail        = 5m
cache-headers     = true
# pgp-auto-sign   = false
# pgp-self-encrypt = true
# pgp-key-id      = YOUR_KEY_ID

