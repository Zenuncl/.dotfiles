# ─── aerc accounts — example ──────────────────────────────────────────────────
#
# This file is normally generated by gen.sh from accounts/*.conf.
# Copy to accounts.conf for manual setup:
#   cp accounts.conf.example accounts.conf
#
# Permissions must be 0600 (aerc enforces this):
#   chmod 600 accounts.conf
#
# Docs: man aerc-accounts

[gmail]
source        = maildir://~/.local/share/mail/gmail
outgoing      = msmtp -a gmail
default       = Inbox
from          = Your Name <you@gmail.com>
copy-to       = Sent
archive       = Archive
postpone      = Drafts
check-mail    = 5m
check-mail-cmd = mbsync --config ~/.config/isync/mbsyncrc gmail && notmuch new
# pgp-auto-sign = false
# pgp-self-encrypt = true
# pgp-key-id = YOUR_KEY_ID

# [work]
# source        = maildir://~/.local/share/mail/work
# outgoing      = msmtp -a work
# default       = Inbox
# from          = Your Name <you@example.com>
# copy-to       = Sent
# archive       = Archive
# postpone      = Drafts
# check-mail    = 5m
# check-mail-cmd = mbsync --config ~/.config/isync/mbsyncrc work && notmuch new
