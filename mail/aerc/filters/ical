#!/usr/bin/env python3
"""Render ICS calendar invites for aerc — zero external dependencies.

aerc filter: receives ICS data on stdin, outputs formatted text to stdout.
"""
import sys
import re
from datetime import datetime

def parse_dt(raw):
    val = raw.split(":")[-1].split(";")[0].strip()
    for fmt in ("%Y%m%dT%H%M%SZ", "%Y%m%dT%H%M%S", "%Y%m%d"):
        try:
            return datetime.strptime(val, fmt)
        except ValueError:
            continue
    return val

def extract_param(line, key):
    m = re.search(rf"{key}=([^;:]+)", line)
    return m.group(1) if m else None

def extract_email(line):
    m = re.search(r"mailto:(.+)", line, re.IGNORECASE)
    return m.group(1) if m else line.split(":")[-1]

text = sys.stdin.read()
text = re.sub(r"\r?\n[ \t]", "", text)

in_event = False
event = {}

for line in text.splitlines():
    stripped = line.strip()
    if stripped == "BEGIN:VEVENT":
        in_event = True
        event = {}
    elif stripped == "END:VEVENT":
        title = event.get("SUMMARY", "No title")
        print(f"\n{'─' * 50}")
        print(f"  {title}")
        print(f"{'─' * 50}")

        start = event.get("DTSTART")
        end = event.get("DTEND")
        if start:
            dt = parse_dt(start)
            if isinstance(dt, datetime):
                out = f"  Date:      {dt.strftime('%a %b %d, %Y')}"
                time_str = dt.strftime("%H:%M")
                if end:
                    edt = parse_dt(end)
                    if isinstance(edt, datetime):
                        time_str += f" → {edt.strftime('%H:%M')}"
                out += f"\n  Time:      {time_str}"
                print(out)
            else:
                print(f"  Date:      {dt}")

        loc = event.get("LOCATION")
        if loc:
            print(f"  Location:  {loc}")

        org = event.get("ORGANIZER")
        if org:
            name = extract_param(org, "CN") or extract_email(org)
            print(f"  Organizer: {name}")

        attendees = event.get("ATTENDEES", [])
        if attendees:
            print(f"\n  Attendees:")
            for a in attendees:
                name = extract_param(a, "CN") or extract_email(a)
                status = extract_param(a, "PARTSTAT") or ""
                mark = {"ACCEPTED": "✓", "DECLINED": "✗", "TENTATIVE": "?"}.get(status, " ")
                print(f"    {mark} {name}")

        desc = event.get("DESCRIPTION")
        if desc:
            desc = desc.replace("\\n", "\n").replace("\\,", ",").replace("\\;", ";")
            print(f"\n  {desc[:500].strip()}")
        print()
        in_event = False
    elif in_event:
        m = re.match(r"^([\w-]+)[;:](.+)", line)
        if m:
            key, val = m.group(1), m.group(2)
            if key == "ATTENDEE":
                event.setdefault("ATTENDEES", []).append(val)
            elif key in ("SUMMARY", "LOCATION", "DESCRIPTION"):
                event[key] = val.split(":", 1)[-1] if ":" in val else val
            else:
                event[key] = line
