{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#cad3f5",
    "margin": 2
  },
  "block_quote": {
    "color": "#a5adcb",
    "italic": true,
    "indent": 2,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "color": "#cad3f5",
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#8aadf4",
    "bold": true
  },
  "h1": {
    "prefix": "# ",
    "color": "#c6a0f6",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#8aadf4"
  },
  "h3": {
    "prefix": "### ",
    "color": "#8bd5ca"
  },
  "h4": {
    "prefix": "#### ",
    "color": "#eed49f"
  },
  "link": {
    "color": "#91d7e3",
    "underline": true
  },
  "link_text": {
    "color": "#f5bde6"
  },
  "image": {
    "color": "#f5bde6",
    "underline": true
  },
  "image_text": {
    "color": "#c6a0f6"
  },
  "code": {
    "color": "#a6da95"
  },
  "code_block": {
    "color": "#cad3f5",
    "margin": 2,
    "chroma": {
      "text": { "color": "#cad3f5" },
      "comment": { "color": "#6e738d" },
      "keyword": { "color": "#c6a0f6" },
      "keyword_type": { "color": "#8aadf4" },
      "literal_string": { "color": "#a6da95" },
      "literal_number": { "color": "#f5a97f" },
      "name_function": { "color": "#8aadf4" },
      "name_class": { "color": "#eed49f" }
    }
  },
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#5b6078"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {
    "color": "#eed49f",
    "bold": true
  },
  "definition_description": {
    "block_prefix": "\n  "
  },
  "html_block": {},
  "html_span": {}
}
