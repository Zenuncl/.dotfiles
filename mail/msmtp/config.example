# ─── msmtp — SMTP sending config ──────────────────────────────────────────────
#
# Copy to the real config:
#   cp config.example config
#
# Symlink: ~/.config/msmtp → ~/.dotfiles/mail/msmtp
# Test:    echo "test" | msmtp -a gmail you@gmail.com

defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile        ~/.local/state/msmtp/msmtp.log

# ─── Gmail ────────────────────────────────────────────────────────────────────

account gmail
host    smtp.gmail.com
port    587
from    you@gmail.com
user    you@gmail.com
passwordeval "pass show email/gmail"

# ─── Work (uncomment & adapt) ────────────────────────────────────────────────

# account work
# host    smtp.example.com
# port    587
# from    you@example.com
# user    you@example.com
# passwordeval "pass show email/work"

# ─── Default account ─────────────────────────────────────────────────────────

account default : gmail
